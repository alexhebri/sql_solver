{
  "manifest_version": 2,
  "name": "SQL Solver",
  "version": "1.0.0",
  "description": "Generate or improve SQL using OpenRouter.",
  "permissions": ["storage"],
  "browser_action": {
    "default_title": "SQL Solver",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
